# ======================================================================
# Alibaba B2B Sourcing - configuration (copy to .env; never commit .env)
# ======================================================================

# --- ScrapingBee (required for LIVE scrapes only; never exposed by the API) ---
SCRAPINGBEE_API_KEY=your_api_key_here
SCRAPINGBEE_URL=https://app.scrapingbee.com/api/v1/
ALIBABA_SEARCH_URL=https://www.alibaba.com/trade/search
SCRAPINGBEE_WAIT_MS=3000
SCRAPINGBEE_TIMEOUT=90
# false = premium proxy (30 credits/page), true = stealth proxy (80 credits/page)
SCRAPINGBEE_STEALTH_PROXY=false
MAX_PRODUCTS_PER_PAGE=15
DEFAULT_PAGES=1
REQUEST_DELAY_SECONDS=1.0
DEBUG_DIR=debug_raw

# --- RFQ / grouping ---
RFQ_EXCEL_FILE=templates/products.xlsx
# fine | balanced | broad
FAMILY_GRANULARITY=balanced
RECOMMEND_TOP_N=5

# --- Client filter defaults ---
CLIENT_REQUIRED_CERTS=
CLIENT_MIN_YEARS=0
CLIENT_REQUIRE_TRADE_ASSURANCE=false
CLIENT_STRICT_MOQ=false
CLIENT_STRICT_CERTS=false
STRICT_MIN_PRICE=false

# --- Score weights ---
WEIGHT_PRICE=30
WEIGHT_MOQ=20
WEIGHT_TRADE_ASSURANCE=20
WEIGHT_YEARS=15
WEIGHT_CERTS=15
WEIGHT_VENDOR_SCORE=75
WEIGHT_RFQ_FIT=25

# --- Legacy CLI-only defaults (optional) ---
DEFAULT_TERMS_FILE=terms.txt
DEFAULT_OUTPUT_FILE=results.json

# ======================================================================
# Backend API
# ======================================================================
# Comma-separated browser origins allowed to call the API (your SvelteKit app)
# Only needed if a BROWSER calls this API directly. The SvelteKit frontend calls it server-side
# (with the user's PocketBase token), so this can stay as is.
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=20
# Where PocketBase lives for the backend (docker compose overrides this to http://pocketbase:8090)
POCKETBASE_URL=http://localhost:8090
# Credit-spending routes require a verified email. This needs SMTP configured below.
REQUIRE_VERIFIED_EMAIL=true
# Comma-separated verified emails allowed to evict cache entries / read debug payloads
ADMIN_EMAILS=
# Optional spend guardrails (leave empty for unlimited)
MAX_CREDITS_PER_JOB=
MAX_CREDITS_PER_DAY=
# Runtime data dir and PocketBase wiring (defaults shown; usually no need to change)
# OUTPUT_DIR=output
# POCKETBASE_USERS_COLLECTION=users
# AUTH_CACHE_TTL_SECONDS=60
# POCKETBASE_MIRROR=true

# ======================================================================
# PocketBase (docker compose)
# ======================================================================
# First superuser, created on first boot. Set both, then remove the password if you like.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
PB_APP_NAME=Alibaba Sourcing
# Public URL of the frontend (used in verification / reset emails)
PB_APP_URL=http://localhost:5173
# SMTP (required for email verification; leave PB_SMTP_HOST empty to disable)
PB_SMTP_HOST=
PB_SMTP_PORT=587
PB_SMTP_USERNAME=
PB_SMTP_PASSWORD=
PB_SMTP_TLS=false
PB_SMTP_SENDER=

# Host bindings (127.0.0.1 = local only; use 0.0.0.0 only behind a TLS reverse proxy)
PB_BIND=127.0.0.1
PB_PORT=8090
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000

# Dev-only frontend (separate repo; used with: docker compose --profile frontend up)
# Production is deployed from the valenvalley monorepo, not from here.
FRONTEND_CONTEXT=../front
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
